# CareLoop provider configuration example.
# Copy this file to a private local file such as .env or configs/provider.local.env.
# Never commit real API keys, notebook tokens, or gateway credentials.

# OpenAI-compatible chat completions endpoint. Either /v1 or /v1/chat/completions is accepted
# by CareLoop runtime clients depending on the script; see README commands.
export CARELOOP_LITE_BASE_URL="https://your-openai-compatible-provider.example/v1"

# Secret API key. Keep only in your shell environment or local ignored file.
export CARELOOP_LITE_API_KEY="replace-with-your-private-key"

# Model used by the CareLoop runtime when a single model is sufficient.
export CARELOOP_LITE_MODEL="replace-with-model-id"

# Optional split-role runtime configuration.
export CARELOOP_LITE_SIM_MODEL="replace-with-simulator-model-id"
export CARELOOP_LITE_DOCTOR_MODEL="replace-with-tested-doctor-label"
export CARELOOP_LITE_DOCTOR_MODEL_API_ID="replace-with-provider-model-id-if-different"

# Model used by trajectory-quality judge scripts.
export CARELOOP_JUDGE_MODEL="replace-with-judge-model-id"
