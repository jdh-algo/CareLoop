    "llm_authoring_policy": {
      "llm_assistance_allowed_for_drafting": true,
      "llm_must_not_run_during_runtime_to_generate_case_facts": true,
      "llm_generated_content_must_be_frozen_in_case_file": true,
      "llm_generated_content_requires_validator_and_review": true
    },
    "migration_notes": [
      "LLM-assisted authoring is allowed only before case freeze; Runtime must never call an LLM to invent case facts during evaluation."
