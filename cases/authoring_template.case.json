      "visibility_checks": [
        "Every clinically meaningful fact has an allowed route or is marked evaluator_only."
      ],
      "scoring_coverage_checks": [
        "Discoverability opportunities and critical failures are discoverability/actionability gated."
      ],
      "reference_trajectory_checks": [
        "Gold/silver/borderline/bad/adversarial trajectories exist and calibrate the evaluator."
      ]
    },
    "clinical_realism_review": {
