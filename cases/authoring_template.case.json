    "schema_version": "validation_contract.v0.9-step9",
    "source": "case.validation_contract",
    "release_status": "draft | authoring_complete | release_candidate | frozen",
    "case_authoring_pipeline": "case_authoring_pipeline.v0.9-step9",
    "case_contract_version": "case_contract.v0.9-step9",
    "validator_policy": {
      "runtime_may_execute_if_authoring_complete": true,
